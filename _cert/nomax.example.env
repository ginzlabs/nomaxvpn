# Copy to _cert/nomax.env. `make init` fills every generated value that is empty.
# Everything in _cert/ except this file is gitignored.

# Provider tokens (from the dashboards)
UPCLOUD_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Server identity
DOMAIN=example.com
UPCLOUD_ZONE=uk-lon1
UPCLOUD_PLAN=STARTER-1xCPU-1GB
# OpenTofu workspace, so a new server can come up beside the old one (empty: default)
TOFU_WORKSPACE=
# Relays' IPv4 addresses, comma-separated (make relay adds them); the first also carries the exit route
RELAYS=

# Generated by `make init` (rotate with `make admin-code`)
ADMIN_CODE=
ADMIN_PATH=
API_PATH=
FILES_PATH=
PRIVACY_PATH=
REVIEW_CODE=
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=
WG_PRIVATE_KEY=

# TestFlight
TESTFLIGHT_URL=
FEEDBACK_EMAIL=

# App Store Connect API key (team YOUR_TEAM_ID). The .p8 lives next to this file.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=
ASC_APP_ID=
DIST_P12_PASSWORD=

# Android release signing (make android-release creates _cert/android.p12 and fills this in)
ANDROID_KEYSTORE_PASSWORD=
