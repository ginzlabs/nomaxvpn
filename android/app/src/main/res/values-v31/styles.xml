<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the launch screen itself; MainActivity fades it out. -->
    <style name="NoMax" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
