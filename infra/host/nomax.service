[Unit]
Description=nomax VPN server and panel
After=network-online.target wg-quick@wg0.service strongswan.service
Wants=network-online.target wg-quick@wg0.service strongswan.service

[Service]
ExecStart=/usr/local/bin/nomax
EnvironmentFile=/etc/nomax/nomax.env
User=nomax
Group=nomax
StateDirectory=nomax
StateDirectoryMode=0700
RuntimeDirectory=nomax
RuntimeDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=65535
MemoryMax=700M
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
